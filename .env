
# echo "The script you are running has basename $(basename "$0"), dirname $(dirname "$0")"


docker build -t tf $(dirname "$0")


echo "fake:x:$(id -u):$(id -g):Fake Fake,,,,:/home/runner/workdir:/bin/nologin" > ~/.fake_passwd

alias tf='docker run -it --rm --network=host \
  -v `pwd`/../:/home/runner/workdir \
  -v ~/terraform_key.json:/terraform_key.json:ro \
  -v ~/.fake_passwd:/etc/passwd:ro \
  -e CWD=$(pwd | awk -F/ "{print \$NF}") \
  -e GOOGLE_CREDENTIALS=/terraform_key.json  \
  -e GOOGLE_PROJECT=ardent-rarity-239115 \
  -e GOOGLE_REGION=us-east4 \
  -e HOME=/home/runner/workdir \
  --dns=$(grep ^nameserver  /etc/resolv.conf | head -1 | awk "{print \$2}") \
  --user $(id -u) \
  tf'
