
# echo "The script you are running has basename $(basename "$0"), dirname $(dirname "$0")"


docker build -t tf $(dirname "$0")


echo "fake:x:$(id -u):$(id -g):Fake Fake,,,,:/home/fake:/bin/nologin" > ~/.fake_passwd

alias tf='docker run -it --rm --network host \
  -v `pwd`/../../../:/home/runner/workdir \
  -v ~/terraform_key.json:/terraform_key.json:ro \
  -v ~/.fake_passwd:/etc/passwd:ro \
  --tmpfs /home/fake:exec,mode=1777 \
  -e CWD=$(pwd | awk -F/ "{print \$(NF-2)\"/\"\$(NF-1)\"/\"\$NF}") \
  -e GOOGLE_CREDENTIALS=/terraform_key.json  \
  -e GOOGLE_PROJECT=ardent-rarity-239115 \
  -e GOOGLE_REGION=us-east4 \
  -e VAULT_TOKEN=${VAULT_TOKEN} \
  -e TF_VAR_OidcDiscoveryUrl=${OidcDiscoveryUrl} \
  -e TF_VAR_OidcClientId=${OidcClientId} \
  -e TF_VAR_OidcClientSecret=${OidcClientSecret} \
  -e HOME=/home/fake \
  --dns=$(grep ^nameserver  /etc/resolv.conf | head -1 | awk "{print \$2}") \
  --user $(id -u) \
  tf'

alias tfprod='docker run -it --rm --network host \
  -v `pwd`/../../../:/home/runner/workdir \
  -v ~/terraform_key-prod.json:/terraform_key.json:ro \
  -v ~/.fake_passwd:/etc/passwd:ro \
  --tmpfs /home/fake:exec,mode=1777 \
  -e CWD=$(pwd | awk -F/ "{print \$(NF-2)\"/\"\$(NF-1)\"/\"\$NF}") \
  -e GOOGLE_CREDENTIALS=/terraform_key.json  \
  -e GOOGLE_PROJECT=orbital-wording-233917 \
  -e GOOGLE_REGION=us-east4 \
  -e VAULT_TOKEN=${VAULT_TOKEN} \
  -e TF_VAR_OidcDiscoveryUrl=${OidcDiscoveryUrl} \
  -e TF_VAR_OidcClientId=${OidcClientId} \
  -e TF_VAR_OidcClientSecret=${OidcClientSecret} \
  -e HOME=/home/fake \
  --dns=$(grep ^nameserver  /etc/resolv.conf | head -1 | awk "{print \$2}") \
  --user $(id -u) \
  tf'


alias tg='docker run -it --rm --network=host \
  -v `pwd`/../../../:/home/runner/workdir \
  -v ~/.fake_passwd:/etc/passwd:ro \
  --tmpfs /home/fake:exec,mode=1777 \
  -e CWD=$(pwd | awk -F/ "{print \$(NF-2)\"/\"\$(NF-1)\"/\"\$NF}") \
  -e CONF_PATH=config.tfvars.json \
  -e VAULT_TOKEN=${VAULT_TOKEN} \
  -e VAULT_ADDR=https://vault.t.regemini.io \
  -e CLUSTER=sandbox \
  -e TF_VAR_Color=green \
  -e HOME=/home/fake \
  --dns=$(grep ^nameserver  /etc/resolv.conf | head -1 | awk "{print \$2}") \
  --user $(id -u) \
  --entrypoint "/docker-entrypoint-tg.sh" \
  tf'

  alias tgprod='docker run -it --rm --network=host \
    -v `pwd`/../../../:/home/runner/workdir \
    -v ~/.fake_passwd:/etc/passwd:ro \
    --tmpfs /home/fake:exec,mode=1777 \
    -e CWD=$(pwd | awk -F/ "{print \$(NF-2)\"/\"\$(NF-1)\"/\"\$NF}") \
    -e CONF_PATH=prod.tfvars.json \
    -e VAULT_TOKEN=${VAULT_TOKEN} \
    -e VAULT_ADDR=https://vault.p.regemini.io \
    -e CLUSTER=production \
    -e TF_VAR_Color=green \
    -e HOME=/home/fake \
    --dns=$(grep ^nameserver  /etc/resolv.conf | head -1 | awk "{print \$2}") \
    --user $(id -u) \
    --entrypoint "/docker-entrypoint-tg.sh" \
    tf'
