{
  "ACCESS_KEY_ID": "${creds.access_key}",
  "BUCKET": "${values.bucket}",
  "ENDPOINT": "%{~ if values.template == "ext" }minio-helm.p.regemini.io%{~ else }minio.minio-helm.svc.cluster.local%{~ endif }%{~ if lookup(values,"port",false) != false }:${values.port}%{~ endif}",
  "SECRET_ACCESS_KEY": "${creds.secret_key}",
  "SECURE": "TRUE"%{~ if values.template != "ext" },
  "CA_CRT": ${jsonencode(ca_crt)}
%{~ endif }
}
