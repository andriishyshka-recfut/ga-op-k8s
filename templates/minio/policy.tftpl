{
  "Version":"2012-10-17",
  "Statement": [

%{ for policy in values ~}
%{ if lookup(policy, "type", "no_admin" ) == "admin" ~}
    {
        "Effect": "Allow",
        "Action": [
            "admin:*"
        ]
    },
    {
        "Effect": "Allow",
        "Action": [
            "kms:*"
        ]
    },
    {
        "Effect": "Allow",
        "Action": [
            "s3:*"
        ],
        "Resource": [
            "arn:aws:s3:::*"
        ]
    }
%{ else ~}
    {
      "Sid":"${uuid}-${index(values,policy) + 1}",
      "Effect": "Allow",
      "Action": [%{ for action in policy.access ~}"s3:${action}"%{if index(policy.access,action) != length(policy.access)-1},%{ endif } %{ endfor ~}],
      "Principal":"*",
      "Resource": "arn:aws:s3:::${policy.bucket}/%{ if lookup(policy, "folder", false ) != false ~}${policy.folder}/*%{ else ~}*%{ endif ~}"
    },
%{ endif ~}
%{ if lookup(policy, "folder", false ) != false ~}
    {
      "Sid": "${uuid}-${index(values,policy) + 1}-0",
      "Effect": "Allow",
      "Action": ["s3:ListBucket","s3:GetBucketLocation"],
      "Principal":"*",
      "Resource": "arn:aws:s3:::${policy.bucket}/*"
    },
%{ endif ~}
%{ endfor ~}
%{ if lookup(element(values,0), "type", "no_admin" ) != "admin" ~}
    {
      "Sid":"${uuid}-0",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:CreateBucket"
      ],
      "Principal":"*",
      "Resource": "arn:aws:s3:::*"
    }
%{ endif ~}
  ]
}