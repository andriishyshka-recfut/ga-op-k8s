apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ${values.name}
  namespace: ${values.namespace}
spec:
  dataFrom:
    - extract:
        key: secret/data/${values.vault_path}
  refreshInterval: ${lookup(values,"refresh_interval","5m")}
  secretStoreRef:
    kind: SecretStore
    name: vault-backend
  target:
    name: ${values.secret_name}
