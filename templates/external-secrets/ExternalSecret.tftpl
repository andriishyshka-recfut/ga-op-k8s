apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ${values.name}
  namespace: ${values.namespace}
spec:
%{ if lookup(values, "template_data", false) == false ~}
  dataFrom:
    - extract:
        key: secret/data/${values.vault_path}
%{ endif ~}
  refreshInterval: ${lookup(values,"refresh_interval","5m")}
  secretStoreRef:
    kind: SecretStore
    name: ${lookup(values,"vault_backend","vault-backend")}
  target:
    name: ${ values.secret_name }
%{ if lookup(values, "template_data", false) != false ~}
  data:
%{ for item in values.template_data ~}
    - secretKey: ${ item.k8s_key }
      remoteRef:
        key: secret/data/${values.vault_path}
        property: ${ item.vault_key }
%{ endfor ~}
%{ endif ~}
