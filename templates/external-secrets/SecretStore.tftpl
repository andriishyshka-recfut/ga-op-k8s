apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: vault-backend
  namespace: ${values.namespace}
spec:
  provider:
    vault:
      auth:
        kubernetes:
          mountPath: k8s-${values.cluster}-${values.color}
          role: external-secrets
      server: ${lookup(values,"vault_url","http://vault-active.vault:8200")}
      version: v2