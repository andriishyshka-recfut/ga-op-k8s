    "logstash-ro": ["logstash-ro"],
    "etl-logstash-feeds-rw": ["etl-logstash-feeds-rw"],
    "birl-images-rw": ["birl-images-rw"],
    "mycop-images-rw": ["mycop-images-rw"],
    "backup-rw": ["backup-rw"],
    "xbackup-rw": ["xbackup-rw"],
    "minio-es7-rw": ["minio-es7-rw"],
    "kubescape-reports-rw": ["kubescape-reports-rw"],
    "gitlab-rw": [
      "gitlab-backup-storage-rw",
