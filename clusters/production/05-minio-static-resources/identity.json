{
  "users": {
    "backup": {"groups": ["backup-rw", "xbackup-rw"]},
    "elastic-backup": {"groups": ["backup-rw", "minio-es7-rw"]},
    "etherpad": {"groups": ["xbackup-rw"]},
    "etl": {
      "groups": [
        "logstash-rw",
        "etl-logstash-feeds-rw",
        "birl-images-rw",
        "mycop-images-rw"
      ],
      "sa": [
        "etl"
      ]
    },
    "etl_exporter": {"groups": ["logstash-rw", "kubescape-reports-rw"]},
    "gitlab": {"groups": ["gitlab-rw"]},
    "gitlab-runner": {"groups": ["gitlab-runner-rw"]},
    "sftpgo": {"groups": ["sftpgo-rw"]},
    "harbor": {"groups": ["harbor-rw", "xbackup-rw"]},
    "kubescape": {"groups": ["kubescape-reports-rw"]},
    "kafka-checker": {"groups": ["kafka-backups-rw"]},
    "logstash_red": {
      "groups": ["logstash-rw", "etl-logstash-feeds-rw", "vandelay-rw"],
      "sa": [
        "logstash_red"
      ]
    },
    "telegram": {
      "groups": ["telegram-rw"],
      "sa": [
        "birl",
        "birl-api",
        "os3c",
        "os3t",
        "telegram-rw",
        "upsertbirl",
        "whirl-telegram"
      ]
    },
    "xdebug": {"groups": ["xdebug-rw"], "sa": ["mapper", "os3d"]},
    "maid": {"groups": ["maid-rw"], "sa": ["clean"]},
    "clicker": {"groups": ["clicker-rw"]},
    "magescanner": {"groups": ["magescanner-rw"]},
    "ocr": {"groups": ["telegram-rw", "dome-attachements-rw"]},
    "swirl": {"groups": ["telegram-rw", "dome-attachements-rw"]},
    "similarweb": {"groups": ["similarweb-rw"]},
    "minifier": {
      "groups": [
        "telegram-rw",
        "birl-images-rw",
        "mycop-images-rw",
        "xdebug-rw"
      ]
    },
    "attachements": {"groups": ["dome-attachements-rw"]},
    "tarantool": {"groups": ["tarantool-rw"]},
    "thanos": {"groups": ["thanos-rw"]},
    "datafix": {
      "groups": ["datafix-rw", "telegram-rw", "xdebug-rw", "mycop-images-rw"]
    },
    "aws2kafka": {"groups": ["telegram-rw"]},
    "vandelay": {
      "groups": ["vandelay-rw", "logstash-ro", "xdebug-rw"],
      "sa": ["vandelay"]
    }
  },

  "policies": {
    "APP-GA-OP": {"admin": ["*"]},
    "APP-GA-DEV": {
      "minio-dome-attachements": ["GetObject", "ListBucket"],
      "minio-xdebug": ["GetObject", "ListBucket"],
      "minio-maid": ["GetObject", "ListBucket"],
      "minio-telegram": ["GetObject", "ListBucket"],
      "minio-os3-attachements": ["GetObject", "ListBucket"],
      "minio-datafix": ["GetObject", "ListBucket"],
      "minio-birl-images-rw": ["GetObject", "ListBucket"],
      "minio-mycop-images": ["GetObject", "ListBucket"]
    },
    "APP-GA-HUNT": {
      "minio-meganz": ["GetObject", "ListBucket"],
      "minio-os3-attachements": ["GetObject", "ListBucket"],
      "minio-maid": ["GetObject", "ListBucket"],
      "minio-telegram": ["GetObject", "ListBucket"],
      "minio-clicker": ["GetObject", "ListBucket"]
    },
    "APP-GA-COLLECTIONS": {
      "minio-os3-attachements": ["GetObject", "ListBucket"],
      "minio-dome-attachements": ["GetObject", "ListBucket"],
      "minio-maid": ["GetObject", "ListBucket"],
      "minio-meganz": ["GetObject", "ListBucket"],
      "minio-telegram": ["GetObject", "ListBucket"],
      "minio-xdebug": ["GetObject", "ListBucket"],
      "minio-datafix": ["GetObject", "ListBucket"]
    },
    "telegram-rw": {"minio-telegram": ["*"]},
    "maid-rw": {"minio-maid": ["*"]},
    "clicker-rw": {"minio-clicker": ["*"]},
    "magescanner-rw": {"minio-magescanner": ["*"]},
    "xdebug-rw": {"minio-xdebug": ["*"]},
    "dome-attachements-rw": {"minio-dome-attachements": ["*"]},
    "similarweb-rw": {"minio-similarweb": ["*"]},
    "logstash-rw": {"minio-logstash": ["*"]},
    "logstash-ro": {"minio-logstash": ["GetObject", "ListBucket"]},
    "etl-logstash-feeds-rw": {"etl-logstash-feeds": ["*"]},
    "birl-images-rw": {"minio-birl-images": ["*"]},
    "mycop-images-rw": {"minio-mycop-images": ["*"]},
    "backup-rw": {"minio-backup": ["*"]},
    "xbackup-rw": {"minio-xbackup": ["*"]},
    "minio-es7-rw": {"minio-es7": ["*"]},
    "kubescape-reports-rw": {"kubescape-reports": ["*"]},
    "gitlab-backup-storage-rw": {"minio-gitlab-backup-storage": ["*"]},
    "gitlab-tmp-storage-rw": {"minio-gitlab-tmp-storage": ["*"]},
    "gitlab-lfs-storage-rw": {"minio-gitlab-lfs-storage": ["*"]},
    "gitlab-runner-rw": {"minio-gitlab-runner-cache": ["*"]},
    "sftpgo-rw": {"minio-sftpgo": ["*"]},
    "harbor-rw": {"harbor": ["*"]},
    "kafka-backups-rw": {"minio-kafka-backups": ["*"]},
    "datafix-rw": {"minio-datafix": ["*"]},
    "tarantool-rw": {"tarantool-backup": ["*"]},
    "vandelay-rw": {"vandelay": ["*"]},
    "thanos-rw": {"thanos": ["*"]}
  },
  "groups": {
    "telegram-rw": ["telegram-rw"],
    "maid-rw": ["maid-rw"],
