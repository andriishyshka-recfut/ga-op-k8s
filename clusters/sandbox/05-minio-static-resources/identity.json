{
  "users": {
    "backup": {
      "groups": ["backup-rw"], 
      "sa": [
        {"name": "ns", "bucket":"backup", "template": "int"}
        ]},
    "telegram": {
      "groups": ["debug-rw","telegram-sessions-rw"],
      "sa": [
        {"name": "minion","bucket": "debug", "template": "int"}
      ]
    }
  },

  "groups": {
    "backup-rw": ["backup-rw"],
    "telegram-rw": ["telegram-rw"],
    "debug-rw": ["debug-rw"],
    "telegram-sessions-rw": ["telegram-sessions-rw"]
  },
  "policies": {
    "APP-GA-OP": [{"type": "admin"}],
    "APP-GA-DEV": [
      {"bucket":"debug", "access": ["GetObject", "ListBucket","GetObjectTagging"]},
      {"bucket": "telegram", "access": ["*"]}
    ],
    "backup-rw": [{"bucket": "backup", "access": ["*"]}],
    "telegram-rw": [{"bucket": "telegram", "access": ["*"]}],
    "debug-rw": [{"bucket": "debug", "access": ["*"]}],
    "telegram-sessions-rw": [{"bucket": "telegram", "access": ["*"], "folder": "sessions"}]
  }
}
