existingSecret: "minio-credentials"

replicas: 1

persistence:
  enabled: false
  size: 5Gi

resources:
  requests:
    memory: 0.5Gi
    cpu: 10m
  limits:
   memory: 1G
   cpu: 200m


environment:
  MINIO_IDENTITY_OPENID_CONFIG_URL: "${OIDC_DISCOVERY_URL}/.well-known/openid-configuration"
  MINIO_IDENTITY_OPENID_CLIENT_ID: "${CLIENT_ID}"
  MINIO_IDENTITY_OPENID_SCOPES: "openid,profile,email"
  MINIO_IDENTITY_OPENID_CLAIM_NAME: "hd"
  MINIO_DOMAIN: "minio.infra.digaweb.com"
  GOOGLE_APPLICATION_CREDENTIALS: "/etc/credentials/gcs_key.json"

#buckets:
#  - name: maid
#    policy: none
#    purge: false

image:
  repository: minio/minio
  tag: latest
  pullPolicy: IfNotPresent

gcsgateway:
        enabled: true
        projectId: ardent-rarity-239115
        replicas: 1

serviceAccount:
  create: false
