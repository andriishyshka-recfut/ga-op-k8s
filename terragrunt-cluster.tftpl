variable "RuntimeContext" {}

provider "google" {
}

provider "google-beta" {
}

provider "vault" {
  address = "${Vault}"
}
%{if Folder == "cluster" ~}
locals {
  gkeClusterEndpoint   = module.gke-setup-${Color}.GkeClusterConnectionSettings.HOST
  gkeBearerToken       = module.gke-setup-${Color}.GkeClusterConnectionSettings.API_KEY
  clusterCaCertificate = module.gke-setup-${Color}.GkeClusterConnectionSettings.CLUSTER_CA_CERTIFICATE
}
%{ else ~}
locals {
  gkeClusterEndpoint   = local.GkeClusterConnectionSettings.HOST
  gkeBearerToken       = local.GkeClusterConnectionSettings.API_KEY
  clusterCaCertificate = local.GkeClusterConnectionSettings.CLUSTER_CA_CERTIFICATE
  artifactoryRepoDomain = var.RuntimeContext == "tekton" ? "repo-external.recfut.com" : "repo.recfut.com"
}
provider "helm" {
  kubernetes = {
    host                   = local.gkeClusterEndpoint
    token                  = local.gkeBearerToken
    cluster_ca_certificate = local.clusterCaCertificate
  }
}

provider "kubernetes" {
  host                   = local.gkeClusterEndpoint
  token                  = local.gkeBearerToken
  cluster_ca_certificate = local.clusterCaCertificate
}

provider "kubectl" {
  cluster_ca_certificate = local.clusterCaCertificate
  host                   = local.gkeClusterEndpoint
  token                  = local.gkeBearerToken
  load_config_file       = false
}
data "vault_generic_secret" "gitlab" {
  path = "secret/misc/gitlab/token/terraform"
}
provider "gitlab" {
  base_url = "https://gitlab.regemini.com/api/v4/"
  token = data.vault_generic_secret.gitlab.data["token"]
}
%{ endif ~}

terraform {
  backend "gcs" {
    bucket = "${Bucket}"
    prefix = "terraform-K8S-${Cluster}/${Color}/${Folder}"
  }
%{if Folder == "main" ~}
  required_providers {
    kubectl = {
      source = "gavinbunney/kubectl"
    }
  }
%{ endif ~}
}
