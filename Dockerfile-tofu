FROM --platform=linux/amd64 vault:1.13.3 as vault
FROM --platform=linux/amd64 curlimages/curl as curl
COPY ./references/zscaler/ZscalerRootCertificate-2048-SHA256-Feb2025.crt /tmp/zscaler.crt
RUN test -f /etc/ssl/certs/ca-certificates.crt; \
    cat /etc/ssl/certs/ca-certificates.crt /tmp/zscaler.crt > /tmp/ca.crt; \
    curl --cacert /tmp/ca.crt https://storage.googleapis.com/kubernetes-release/release/$(curl --cacert /tmp/ca.crt -fsSL https://storage.googleapis.com/kubernetes-release/release/stable.txt)/bin/linux/amd64/kubectl --output /tmp/kubectl &&\
    curl -L --cacert /tmp/ca.crt https://github.com/gruntwork-io/terragrunt/releases/download/v0.99.1/terragrunt_linux_amd64 --output /tmp/terragrunt &&\
    curl -L --cacert /tmp/ca.crt https://github.com/opentofu/opentofu/releases/download/v1.11.4/tofu_1.11.4_amd64.apk --output /tmp/opentofu.apk

FROM --platform=linux/amd64 alpine:latest as ansible

COPY ./references/zscaler/ZscalerRootCertificate-2048-SHA256-Feb2025.crt /usr/local/share/ca-certificates/zscaler-root.crt
RUN apk add --no-cache ca-certificates && update-ca-certificates
RUN update-ca-certificates

RUN apk add python3 py3-pip unzip py3-virtualenv bash python3-dev libffi-dev build-base rust rustup cargo openssl-dev musl-dev
RUN cd / && python3 -m venv ansible && \
    bash -c "source /ansible/bin/activate && pip install --upgrade pip && pip install ansible pyyaml==5.3.1 docker-compose jmespath kubernetes openshift requests google-auth ansible-modules-hashivault pyopenssl kafka-python"

FROM --platform=linux/amd64 alpine:latest


COPY --from=vault /bin/vault /bin/vault
COPY --from=curl /tmp/kubectl /bin/kubectl
COPY --from=curl /tmp/terragrunt /bin/terragrunt
COPY --from=curl /tmp/opentofu.apk /tmp/opentofu.apk
COPY --from=ansible /ansible /ansible



RUN apk add  --no-cache tar openssh-client jq bash rsync python3 openssl git && \
    apk add --allow-untrusted /tmp/opentofu.apk && \
    chmod +x /bin/kubectl && chmod +x /bin/terragrunt && \
    adduser -u 10123 executor -S && \
    mkdir -p /home/runner/workdir && mkdir /home/fake && chmod 777 /home/fake

RUN mkdir -p /usr/share/terraform/plugins/registry.terraform.io/aminueza/minio/3.6.5/linux_amd64/
COPY ./references/minio-provider/terraform-provider-minio /usr/share/terraform/plugins/registry.terraform.io/aminueza/minio/3.6.5/linux_amd64/terraform-provider-minio_v.3.6.5
COPY ./references/minio-provider/.tofurc /etc/tofurc

COPY ./references/zscaler/ZscalerRootCertificate-2048-SHA256-Feb2025.crt /usr/local/share/ca-certificates/zscaler-root.crt
RUN apk add --no-cache ca-certificates && update-ca-certificates
RUN update-ca-certificates

USER 10123:10123

WORKDIR /home/runner/workdir
COPY ./dummy-kubecfg /.kubeconfig
COPY ./docker-entrypoint-tofu.sh /
COPY ./docker-entrypoint-tg.sh /
ENTRYPOINT ["/docker-entrypoint-tofu.sh"]
CMD ["--help"]
