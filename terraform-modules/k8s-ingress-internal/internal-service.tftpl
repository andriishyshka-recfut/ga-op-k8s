apiVersion: v1
kind: Service
metadata:
  name: ${name}
  namespace: ${settings.namespace}
spec:
  clusterIP: None
  internalTrafficPolicy: Cluster
  ports:
  - name: ${name}
    port: ${settings.port}
    protocol: TCP
    targetPort: ${settings.target_port}
  sessionAffinity: None
  type: ClusterIP

