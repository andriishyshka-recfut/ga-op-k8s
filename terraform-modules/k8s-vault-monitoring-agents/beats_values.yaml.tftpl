beatsVersion: "8.16.6"
namespace: "monitoring"
esName: "mon"
metricbeat:
  name: "mon"
auditbeat:
  name: "audit"
dashboards:
  # Only "yes" take effect
  enabled: "yes"
  kibana: "kibana"
filebeat:
  name: "log"
  priorityClassName: ${priority_class}
  config: |
    filebeat.autodiscover:
      providers:
        - node: $${NODE_NAME}
          type: kubernetes
          hints.enabled: true
          hints.default_config.enabled: true
          hints.default_config:
            type: container
            paths:
              - /var/log/containers/*$${data.kubernetes.container.id}.log

    setup.ilm.enabled: false
    setup.template.enabled: true
    setup.template.name: "filebeat-%%{[agent.version]}"
    setup.template.pattern: "filebeat-%%{[agent.version]}*"
    setup.template.settings:
      index.lifecycle.name: filebeat

    processors:
      - add_fields:
          target: ''
          fields:
            cluster:
              color: ${color}
              stage: ${cluster}

    output.elasticsearch:
      index: "filebeat-%%{[agent.version]}"
%{ if length(filebeat_groups) > 0 ~}
      indices:
%{ for group in tolist(split(",", filebeat_groups)) ~}
        - index: "filebeat-%%{[agent.version]}-${group}"
          when.equals:
            kubernetes.labels.log-group-name: "${group}"
%{ endfor ~}
%{ endif ~}
