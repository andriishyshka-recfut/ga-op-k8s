beatsVersion: "7.13.13"
namespace: "monitoring"
esName: "mon"
metricbeat:
  name: "mon"
auditbeat:
  name: "audit"
dashboards:
  # Only "yes" take effect
  enabled: "yes"
  kibana: "kibana"
filebeat:
  name: "log"
  daemonSet:
    podTemplate:
      spec:
        priorityClassName: ${priority_class}
  config: |
    filebeat.autodiscover:
      providers:
        - host: $${HOSTNAME}
          type: kubernetes
          hints.enabled: true
          hints.default_config.enabled: true
          hints.default_config:
            type: container
            paths:
              - /var/log/containers/*$${data.kubernetes.container.id}.log
    output.elasticsearch:
      index: "filebeat-%%{[beat.version]}-%%{+yyyy.MM.dd}"
%{ if length(filebeat_groups) > 0 ~}      
      indices:
%{ for group in tolist(split(",", filebeat_groups)) ~}
        - index: "filebeat-${group}"
          when.contains:
            kubernetes.labels.log-group-name: "${group}"
%{ endfor ~}
%{ endif ~}
    setup.template.enable: true
    setup.template.name: "filebeat-%%{[beat.version]}"
    setup.template.pattern: "filebeat-%%{[beat.version]}-*" 
