adminPassword: ${grafana.adminPassword}
grafana.ini:
  server:
    root_url: ${grafana.rootUrl}
  auth.okta:
    enabled: true
    name: Okta
    icon: okta
    scopes: openid profile email groups
    auth_url: ${grafana.okta.issuer}/oauth2/v1/authorize
    token_url:  ${grafana.okta.issuer}/oauth2/v1/token
    api_url:  ${grafana.okta.issuer}/oauth2/v1/userinfo
    client_id:  ${grafana.okta.client_id}
    org_attribute_path: groups
    org_mapping:  ${grafana.okta.org_mapping}
    role_attribute_path:  ${grafana.okta.role_attribute_path}
    allow_assign_grafana_admin: true
    allowed_groups: ${grafana.okta.allowed_groups}
  users:
    auto_assign_org_role: Viewer
    auto_assign_org: true
    auto_assign_org_id: 1
persistence:
  type: pvc
  enabled: true
  accessModes:
    - ReadWriteOnce
  size: 5Gi
envValueFrom:
  GF_AUTH_OKTA_CLIENT_SECRET:
    secretKeyRef:
      name: "grafana-okta-client-secret"
      key: client_secret