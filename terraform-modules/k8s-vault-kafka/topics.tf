    for_each = toset(local.defaultSettingTopicsList)
    yaml_body = templatefile("${path.module}/topic-default.yaml", {
        "TOPIC_NAME" = each.key
        "TOPIC_RFC_1123_NAME" = replace(each.key,"_",".")
        })
    depends_on = [
      helm_release.kafka_cluster
    ]
}
