cvat:
  backend:
%{ for volume in volumes_list ~}
    additionalVolumes:
      - name: cvat-backend-data
        persistentVolumeClaim:
          claimName: cvat-backend-data
      - name: cvat-backend-per-service-cache
        emptyDir: {}
%{ endfor ~}
    server:
      resources: 
        requests:
          cpu: 2
          memory: 2024Mi
        limits:
          cpu: 2500m
          memory: 2536Mi