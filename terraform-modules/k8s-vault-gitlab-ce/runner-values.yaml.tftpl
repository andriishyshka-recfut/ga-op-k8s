runners:
  config: |
    concurrent = 12
    check_interval = 0
    [session_server]
      session_timeout = 1800
    [[runners]]
      [runners.kubernetes]
        image = "alpine:3.19.0"
        image_pull_secrets = ["${name}-harbor"]
        cpu_request = "1"
        cpu_limit = "2"
        memory_request = "512Mi"
        memory_limit = "4Gi"
      [runners.cache]
        Type = "s3"
        Path = "/cache/"
        Shared = true
        [runners.cache.s3]
          ServerAddress = "minio.p.regemini.io:443"
          AuthenticationType = "access-key"
          BucketName = "gitlab-tmp-orbital-wording"
  cache:
    secretName: ${name}-minio
