extraEnvVarsSecret: events-credentials
global:
  security:
    allowInsecureImages: true
  imagePullSecrets:
    - harbor
image:
  registry: harbor.regemini.io
  repository: mirror/kubernetes-event-exporter
  tag: ${tag}
resources:
  limits:
    cpu: 300m
    ephemeral-storage: 1Gi
    memory: 512Mi
  requests:
    cpu: 200m
    ephemeral-storage: 100Mi
    memory: 256Mi
config:
  clusterName: ${cluster}-${color}
  logLevel: ${log_level}
  logFormat: pretty
  kubeQPS: 100
  kubeBurst: 500
  maxEventAgeSeconds: 60
  receivers:
    - name: "dump"
      file:
        path: "/dev/stdout"
        layout: {}
    - name: "elastic"
      elasticsearch:
        hosts:
          - https://${elastic_url}
        index: kube-events
        username: kube-events-${cluster}
        password: $${ELASTIC_EVENTS_PASSWORD}
        useEventID: false
        deDot: true
        tls: 
          insecureSkipVerify: true
  route:
    routes:
      - match:
          - receiver: "elastic"
#      - match:
#          - kind: "Pod|Deployment|ReplicaSet"
#            receiver: "elastic"