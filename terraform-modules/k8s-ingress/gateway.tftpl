apiVersion: networking.istio.io/v1alpha3
kind: Gateway
metadata:
  name: ${lookup(settings, "ingressgateway", false) != false ? "${name}-${split("-", settings.ingressgateway)[1]}" : "${name}-wg"}
  namespace: istio-ingress
spec:
  selector:
    istio: ${lookup(settings, "ingressgateway", "ingressgateway")}
  servers:
    - hosts:
%{ for domain in settings.domain ~}
        - ${ domain }
%{ endfor ~}
      port:
        name: ${lookup(settings,"port", 80) != 80 ? name : "http"}   
        number: ${lookup(settings,"port", 80) != 80 ? settings.port : 80 } 
        protocol: ${lookup(settings,"protocol", "HTTP") != "HTTP" ? settings.protocol : "HTTP"}  
%{ if lookup(settings, "port",false) == false ~}
      tls:
        httpsRedirect: true
    - hosts:
%{ for domain in settings.domain ~}
        - ${ domain }
%{ endfor ~}
      port:
        name: https
        number: 443
        protocol: HTTPS
      tls:
        credentialName: ${lookup(settings, "cert-name", "${name}-cert")}
        mode: SIMPLE
%{ endif ~}