secretConfig: true
pod:
  labels:
    "sidecar.istio.io/inject": "false"
resources:
  requests:
    memory: 50Mi
    cpu: 10m
  limits:
    memory: 200Mi
    cpu: 100m

config:
  modules:
    http_2xx:
      prober: http
      timeout: 5s
      http:
        valid_http_versions: ["HTTP/1.1", "HTTP/2.0"]
        follow_redirects: true
        preferred_ip_protocol: "ip4"
    harbor:
      prober: http
      timeout: 5s
      http:
        valid_http_versions: ["HTTP/1.1", "HTTP/2.0"]
        follow_redirects: true
        preferred_ip_protocol: "ip4"
        method: GET
        basic_auth:
          username: ${harbor.user}
          password: ${harbor.password}
    elastic:
      prober: http
      timeout: 5s
      http:
        valid_http_versions: ["HTTP/1.1", "HTTP/2.0"]
        follow_redirects: true
        preferred_ip_protocol: "ip4"
        method: GET
        basic_auth:
          username: ${elastic.USERNAME}
          password: ${elastic.PASSWORD}
        tls_config:
          ca_file: "/etc/secrets/ca_crt"
          cert_file: "/etc/secrets/client_crt"
          key_file: "/etc/secrets/client_key"
    ssh_banner:
      prober: tcp
      timeout: 15m
      tcp:
        query_response:
        - expect: "^SSH-2.0-"
        - send: "SSH-2.0-blackbox-ssh-check"
%{if vortex == true ~}
    vortex:
      prober: http
      timeout: 5s
      http:
        valid_http_versions: ["HTTP/1.1", "HTTP/2.0"]
        follow_redirects: true
        preferred_ip_protocol: "ip4"
        method: GET
        basic_auth:
          username: probe
          password_file: "/etc/basic-auth/vortex/vortex"
        tls_config:
          ca_file: "/etc/certs/vortex/ca.crt"
          cert_file: "/etc/certs/vortex/tls.crt"
          key_file: "/etc/certs/vortex/tls.key"
%{ endif ~}

extraSecretMounts:
  - name: es-secret
    mountPath: /etc/secrets
    secretName: es-secret
    readOnly: true
    defaultMode: 420
%{if vortex == true ~}
  - name: vortex-cert
    mountPath: /etc/certs/vortex
    secretName: vortex-cert
    readOnly: true
    defaultMode: 420
  - name: vortex-auth
    mountPath: /etc/basic-auth/vortex
    secretName: vortex-auth
    readOnly: true
    defaultMode: 420
%{ endif ~}   
    
prometheusRule:
  enabled: true
  additionalLabels:
      app: prometheus
      release: prometheus
      ruler: thanos
  namespace: "monitoring"
  rules:
    - alert: webServiceUnavailible
      annotations:
        description: 'HTTP response code {{ $value }} rather than 200  for {{ $labels.instance }}.'
        summary: Service  unavailible
      expr: |-
        probe_http_status_code != 200
      for: 10m
      labels:
        severity: critical
        cluster: ${cluster}
    - alert: sshServiceUnavailible
      annotations:
        description: 'SSH service unavailble  for {{ $labels.instance }}.'
        summary: Service  unavailible
      expr: |-
        probe_success{module="ssh_banner"} == 0
      for: 10m
      labels:
        severity: critical
        cluster: ${cluster}
    - alert: SSLCertExpiringSoon
      annotations:
        description: 'SSL Certificate for {{ $labels.instance }} is going to expire in 14 days.'
        summary: Action required
      expr: |-
        probe_ssl_earliest_cert_expiry - time() < 86400 * 14
      for: 10m
      labels:
        severity: warning
        cluster: ${cluster}
    - alert: SSLCertExpiringReallySoon
      annotations:
        description: 'SSL Certificate for {{ $labels.instance }} is going to expire in 7 days.'
        summary: Action required
      expr: |-
        probe_ssl_earliest_cert_expiry - time() < 86400 * 7
      for: 10m
      labels:
        severity: warning
        cluster: ${cluster}
    - alert: SSLCertAlmostExpired
      annotations:
        description: 'SSL Certificate for {{ $labels.instance }} is going to expire in 1 days.'
        summary: Action required
      expr: |-
        probe_ssl_earliest_cert_expiry - time() < 86400 * 1
      for: 10m
      labels:
        severity: critical
        cluster: ${cluster}
