      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "CronJobs — Failed Runs",
          "description": "Failed Job runs owned by CronJobs during the selected time range. Counts runs, not parent CronJobs.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "PFD3B38C53C4608D4"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "count(\n  (\n    max by (cluster, color, namespace, job_name) (\n      max_over_time(kube_job_failed{namespace=\"etl\", condition=\"true\"}[${__range_s}s]) == 1\n    )\n  )\n  * on (cluster, color, namespace, job_name) group_left (cronjob)\n  (\n    max by (cluster, color, namespace, job_name, cronjob) (\n      label_replace(\n        max_over_time(kube_job_owner{namespace=\"etl\", owner_kind=\"CronJob\", owner_is_controller=\"true\"}[${__range_s}s]) == 1,\n        \"cronjob\", \"$1\", \"owner_name\", \"(.+)\"\n      )\n    )\n  )\n) or vector(0)",
                        "format": "time_series",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
