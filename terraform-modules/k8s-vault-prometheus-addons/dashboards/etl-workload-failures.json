                        "name": "PFD3B38C53C4608D4"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "label_replace(\n  (\n    (\n      (\n        max by (cluster, color, namespace, job_name, reason) (\n          max_over_time(kube_job_status_failed{namespace=\"etl\"}[${__range_s}s])\n        ) > 0\n      ) > bool 0\n    )\n    * on (cluster, color, namespace, job_name) group_left ()\n    (\n      max by (cluster, color, namespace, job_name) (\n        max_over_time(kube_job_status_start_time{namespace=\"etl\"}[${__range_s}s]) > 0\n      ) * 1000\n    )\n    or\n    (\n      (\n        max by (cluster, color, namespace, job_name, reason) (\n          max_over_time(kube_job_status_failed{namespace=\"etl\"}[${__range_s}s])\n        ) > 0\n      ) * 0\n    )\n  ),\n  \"reason\", \"Not reported\", \"reason\", \"^$\"\n)",
                        "format": "table",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "filterFieldsByName",
                  "spec": {
                    "options": {
                      "include": {
                        "names": [
                          "Value",
                          "job_name",
                          "reason",
                          "cluster",
                          "color"
                        ]
                      }
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {},
                      "indexByName": {
                        "Value": 0,
                        "job_name": 1,
                        "reason": 2,
                        "cluster": 3,
                        "color": 4
                      },
                      "renameByName": {
                        "Value": "Job started"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.1",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": true,
                    "displayName": "Job started"
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "—",
                  "custom": {
                    "align": "left",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false,
                    "minWidth": 100
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Job started"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "time:YYYY-MM-DD HH:mm:ss Z"
                      },
                      {
                        "id": "custom.width",
                        "value": 260
                      },
                      {
                        "id": "custom.align",
                        "value": "left"
                      },
                      {
                        "id": "noValue",
                        "value": "Unavailable"
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "options": {
                              "0": {
                                "index": 0,
                                "text": "Unavailable"
                              }
                            },
                            "type": "value"
                          },
                          {
                            "options": {
                              "match": "null",
                              "result": {
                                "index": 1,
                                "text": "Unavailable"
                              }
                            },
                            "type": "special"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "cluster"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 140
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "color"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 110
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "reason"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 210
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
