apiVersion: monitoring.coreos.com/v1
kind: Probe
metadata:
  name: kibanas
  labels:
    release: prometheus
spec:
  module: http_2xx
  prober:
    url: blackbox-exporter-prometheus-blackbox-exporter:9115
    scheme: http
    path: /probe
  targets:
    staticConfig:
      labels:
        module: http_2xx
      static:
      - https://cluster-info.t.regemini.io/ping
      - https://epl.regemini.io
      - https://geminiadvisory.io/wp-content/themes/gemini/img/gear.svg
      - https://k.regemini.com/status
      - https://kiali.p.regemini.io/ping
      - https://kowl.p.regemini.io/ping
      # - https://starling.regemini.com/status
---
apiVersion: monitoring.coreos.com/v1
kind: Probe
metadata:
  name: harbor
  labels:
    release: prometheus
spec:
  module: harbor
  prober:
    url: blackbox-exporter-prometheus-blackbox-exporter:9115
    scheme: http
    path: /probe
  targets:
    staticConfig:
      labels:
        module: harbor
      static:
      - https://harbor.regemini.io/api/v2.0/health
---
apiVersion: monitoring.coreos.com/v1
kind: Probe
metadata:
  name: ssh
  labels:
    release: prometheus
spec:
  module: ssh_banner
  prober:
    url: blackbox-exporter-prometheus-blackbox-exporter:9115
    scheme: http
    path: /probe
  targets:
    staticConfig:
      labels:
        module: ssh_banner
      static:
      - sftp-server-main.sftp-jobs.svc:22
      - sftp.regemini.io:2222
%{if vortex == true ~}
---
apiVersion: monitoring.coreos.com/v1
kind: Probe
metadata:
  name: vortex
  labels:
    release: prometheus
spec:
  module: vortex
  prober:
    url: blackbox-exporter-prometheus-blackbox-exporter:9115
    scheme: http
    path: /probe
  targets:
    staticConfig:
      labels:
        module: vortex
      static:
      - https://vortex.regemini.com
%{ endif ~}
