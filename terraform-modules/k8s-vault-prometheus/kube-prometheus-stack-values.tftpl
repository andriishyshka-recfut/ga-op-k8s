namespaceOverride: "monitoring"
nameOverride: "prometheus"
fullnameOverride: "prometheus"

grafana:

  sidecar:
    datasources:
      enabled: true
      defaultDatasourceEnabled: true
      isDefaultDatasource: false
  
  assertNoLeakedSecrets: false
  adminPassword: ${grafana_creds.adminPassword}
  envValueFrom:
    ELASTIC_PASSWORD:
      secretKeyRef:
        name: "mon-es-elastic-user"
        key: elastic
    GF_AUTH_OKTA_CLIENT_SECRET:
      secretKeyRef:
        name: "grafana-okta-client-secret"
        key: client_secret
  additionalDataSources:
    - name: "elastic"
      type:  "elasticsearch"
      url: "https://mon-es-http:9200"
      database: "filebeat-*"
      uid: elastic_uid
      basicAuth: true
      isDefault: false
      access: proxy
      basicAuthUser: elastic
      jsonData:
        esVersion: 70
        timeField: "@timestamp"
        tlsSkipVerify: true
      secureJsonData:
        basicAuthPassword: "$ELASTIC_PASSWORD"
    - name: "ThanosQueryFrontend"
      type:  "prometheus"
      url: "http://thanos-query-frontend.monitoring:9090/query/"
      isDefault: true
      access: proxy
      jsonData:
        tlsSkipVerify: true
        timeInterval: "15s"
        queryTimeout: "60s"
        defaultEditor: "code"
        disableMetricsLookup: true 
        prometheusType: "Thanos"
        prometheusVersion: "0.31.0"
        cacheLevel: "None"
        incrementalQuerying: true
        incrementalQueryOverlapWindow: "15m"
        disableRecordingRules: true
        httpMethod: POST
        useSeriesEndpoint: true
      editable: false
  enabled: true
  namespaceOverride: "monitoring"
  resources:
    requests:
      memory: 1024Mi
      cpu: 500m
    limits:
      memory: 1200Mi
      cpu: 600m
  podAnnotations:
    sidecar.istio.io/inject: "false"
  grafana.ini:
    auth.google:
      enabled: true
      scopes: https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/userinfo.email
      auth_url: https://accounts.google.com/o/oauth2/auth
      token_url: https://accounts.google.com/o/oauth2/token
      allowed_domains: geminiadvisory.io
      allow_sign_up: true
      client_id: ${grafana_auth_google.oidc_client_id}
      client_secret: ${grafana_auth_google.oidc_client_secret}
    auth.okta:
      enabled: true
      name: Okta
      icon: okta
      scopes: openid profile email groups
      auth_url: ${okta.issuer}/oauth2/v1/authorize
      token_url:  ${okta.issuer}/oauth2/v1/token
      api_url:  ${okta.issuer}/oauth2/v1/userinfo
      client_id:  ${okta.client_id}
      client_secret:  "$OKTA_CLIENT_SECRET"
      org_attribute_path: groups
      org_mapping:  ${okta.org_mapping}
      role_attribute_path:  ${okta.role_attribute_path}
      allow_assign_grafana_admin: true
      allowed_groups: ${okta.allowed_groups}
    users:
      auto_assign_org_role: ${grafana_users_auto_assign_org_role}
    server:
      root_url: ${grafana_creds.root_url}
  nodeSelector:
    workloadsType: data
  tolerations:
  - key: "workloadsType"
    operator: "Exists"
    effect: "NoSchedule"


kube-state-metrics:
  namespaceOverride: "monitoring"
  customLabels:
    release: prometheus

prometheus-node-exporter:
  namespaceOverride: "monitoring"
  priorityClassName: ${priority_class}
  resources:
    requests:
      memory: 30Mi
      cpu: 10m
    limits:
      memory: 100Mi
      cpu: 100m

prometheusOperator:
  nodeSelector:
    workloadsType: data
  tolerations:
  - key: "workloadsType"
    operator: "Exists"
    effect: "NoSchedule"
  podAnnotations:
    sidecar.istio.io/inject: "false"
  admissionWebhooks:
    patch:
      podAnnotations:
        sidecar.istio.io/inject: "false"
  resources:
    requests:
      memory: 50Mi
      cpu: 10m
    limits:
      memory: 1G
      cpu: 100m

prometheus:
  prometheusSpec:
    replicas: 2
    shards: 2
    prometheusRulesExcludedFromEnforce: false
    terminationGracePeriodSeconds: 1800
    ruleSelector:
      matchLabels:
        release: prometheus
      matchExpressions:
        - key: ruler
          operator: NotIn
          values:
            - thanos

    nodeSelector:
      workloadsType: data
    tolerations:
      - key: "workloadsType"
        operator: "Exists"
        effect: "NoSchedule"

    ###  Url for replace internal cluster domain name for generated url in slack messages
    # externalUrl: "https://prometheus.t.regemini.io"
    # externalUrl: "http://localhost:9090"
    # listenLocal: true
    externalUrl: ${prometheus_external_url}
    podMetadata:
      annotations:
        sidecar.istio.io/inject: "false"
    retention: 7d
    retentionSize: 100GB
    storageSpec:
      volumeClaimTemplate:
        spec:
          resources:
            requests:
              storage: 120Gi
    
    resources:
      requests:
        memory: ${prometheus_resources.RAMreq}
        cpu: ${prometheus_resources.CPUreq}
      limits:
        memory: ${prometheus_resources.RAMlim}
        cpu: ${prometheus_resources.CPUlim}

    containers:
      - name: prometheus
        startupProbe:
          httpGet:
            path: /-/ready
            port: http-web
            scheme: HTTP
          timeoutSeconds: 15
          periodSeconds: 10
          failureThreshold: 360
          successThreshold: 1
        livenessProbe:
          httpGet:
            path: /-/healthy
            port: http-web
            scheme: HTTP
          timeoutSeconds: 10
          periodSeconds: 10
          failureThreshold: 6
        readinessProbe:
          httpGet:
            path: /-/ready
            port: http-web
            scheme: HTTP
          timeoutSeconds: 10
          periodSeconds: 10
          failureThreshold: 3

    thanos:
      version: ${thanos_version}
      baseImage: quay.io/thanos/thanos
      objectStorageConfig:
        existingSecret:
          key: objstore.yml
          name: thanos-objstore-config
      resources:
        requests:
          memory: 0.75Gi
          cpu: 500m
        limits:
          memory: 1Gi
          cpu: 1
    additionalScrapeConfigs:
      - job_name: 'kubernetes-pods'
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
            target_label: __address__
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            action: replace
            target_label: kubernetes_namespace
          - source_labels: [__meta_kubernetes_pod_name]
            action: replace
            target_label: kubernetes_pod_name
      - job_name: 'kubernetes-pods-sp'
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape1]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path1]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port1]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
            target_label: __address__
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            action: replace
            target_label: kubernetes_namespace
          - source_labels: [__meta_kubernetes_pod_name]
            action: replace
            target_label: kubernetes_pod_name

  thanosService:
    enabled: true
    annotations: 
      sidecar.istio.io/inject: "false"
    labels: {}

    type: ClusterIP
    clusterIP: "None"

    portName: grpc
    port: 10901
    targetPort: "grpc"

    httpPortName: http
    httpPort: 10902
    targetHttpPort: "http"

  thanosServiceMonitor:
    enabled: false

thanosRuler:
  enabled: true

  thanosRulerSpec:
    ruleSelector:
      matchLabels:
        ruler: thanos

    replicas: 2

    objectStorageConfig:
      existingSecret:
        key: objstore.yml
        name: thanos-objstore-config
    resources:
      requests:
        memory: 1Gi
        cpu: 500m
      limits:
        memory: 1Gi
        cpu: 2
  
    queryEndpoints:
      - http://thanos-query.monitoring.svc:9090/query/
  
    alertmanagersConfig:
      secret:
        alertmanagers:
        - api_version: v2
          static_configs:
            - alertmanager-operated.monitoring.svc:9093

    alertQueryUrl: ${prometheus_query_url}

# Fix for used with istio
alertmanager:
  alertmanagerSpec:
    externalUrl: ${prometheus_external_url}
    podMetadata:
      annotations:
        sidecar.istio.io/inject: "false"
    # listenLocal: true
    resources:
      requests:
        memory: 50Mi
        cpu: 10m
      limits:
        memory: 800Mi
        cpu: 150m
  config:
    global:
      resolve_timeout: 5m
    receivers:
    - name: "null"
    - name: "slack-critical"
      slack_configs:
        - api_url: ${prometheus_slack_webhooks.gemini_prometheus-critical}
          channel: '#gemini_prometheus-critical'
          text: '{{ template "slack.custom.text" . }}'
          send_resolved: true
    - name: "slack-etl"
      slack_configs:
        - api_url: ${prometheus_slack_webhooks.gemini_prometheus-critical}
          channel: '#gemini_prometheus-critical'
          text: '{{ template "slack.custom.text" . }}'
          send_resolved: true
    - name: "slack-dome-bots"
      slack_configs:
        - api_url: ${prometheus_slack_webhooks.gemini-dome}
          channel: '#gemini-dome'
          text: '{{ template "slack.custom.text" . }}'
          send_resolved: true         
    - name: "slack-minion-bots"
      slack_configs:
        - api_url: ${ cluster == "production" ? prometheus_slack_webhooks.gemini_prometheus-live : prometheus_slack_webhooks.gemini_prometheus-test }
          channel: ${ cluster == "production" ? "'#gemini_prometheus-live'" : "'#gemini_prometheus-test'" }
          text: '{{ template "slack.custom.text" . }}'
          send_resolved: true
    - name: "slack-dome-mapping"
      slack_configs:
        - api_url: ${prometheus_slack_webhooks.gemini-dome}
          channel: '#gemini-dome'
          text: '{{ template "slack.custom.text" . }}'
          send_resolved: true
    - name: "slack-paste"
      slack_configs:
        - api_url: ${ cluster == "production" ? prometheus_slack_webhooks.gemini-artifact : prometheus_slack_webhooks.gemini_prometheus-test }
          channel: ${ cluster == "production" ? "'#gemini-artifact'" : "'#gemini_prometheus-test'" }
          text: '{{ template "slack.custom.text" . }}'
          send_resolved: true
    - name: "slack-devs"
      slack_configs:
        - api_url: ${ cluster == "production" ? prometheus_slack_webhooks.gemini_prometheus-dev : prometheus_slack_webhooks.gemini_prometheus-test }
          channel: ${ cluster == "production" ? "'#gemini_prometheus-dev'" : "'#gemini_prometheus-test'" }
          text: '{{ template "slack.custom.text" . }}'
          send_resolved: true
    - name: "tekton-webhook-notifications-and-slack"
      slack_configs:
        - api_url: ${ cluster == "production" ? prometheus_slack_webhooks.gemini_prometheus-live : prometheus_slack_webhooks.gemini_prometheus-test }
          channel: ${ cluster == "production" ? "'#gemini_prometheus-live'" : "'#gemini_prometheus-test'" }
          send_resolved: true
          text: '{{ template "slack.custom.text" . }}'
    - name: "tekton-and-slack-woresolve"
      slack_configs:
        - api_url: ${ cluster == "production" ? prometheus_slack_webhooks.gemini_prometheus-live : prometheus_slack_webhooks.gemini_prometheus-test }
          channel: ${ cluster == "production" ? "'#gemini_prometheus-live'" : "'#gemini_prometheus-test'" }
          send_resolved: false
          text: '{{ template "slack.custom.text" . }}'
    - name: "tekton-fail-bots-webhook-notifications-and-slack"
      webhook_configs:
        - send_resolved: false
          url: "http://el-fail-bots-webhook-alertmanager-listener.tekton-pipelines:8080"
      slack_configs:
        - api_url: ${ cluster == "production" ? prometheus_slack_webhooks.gemini_prometheus-live : prometheus_slack_webhooks.gemini_prometheus-test }
          channel: ${ cluster == "production" ? "'#gemini_prometheus-live'" : "'#gemini_prometheus-test'" }
          send_resolved: true
          text: '{{ template "slack.custom.text" . }}'
    - name: "tekton-failed-etl-jobs-webhook-notifications-and-slack"
      webhook_configs:
        - send_resolved: false
          url: "http://el-failed-etl-jobs-webhook-alertmanager-listener.tekton-pipelines:8080"
    - name: "tekton-etl-leftovers-webhook"
      webhook_configs:
        - send_resolved: false
          url: "http://el-etl-leftovers-webhook-alertmanager-listener.tekton-pipelines:8080"
    - name: "telegram-session-change-proxy-webhook"
      webhook_configs:
        - send_resolved: false
          url: "http://el-telegram-session-change-proxy-webhook-alertmanager-listener.tekton-pipelines:8080"
    - name: "failed-pods-cleanup-webhook"
      webhook_configs:
        - send_resolved: false
          url: "http://el-crashloopbackoffpod-webhook-alertmanager-listener.tekton-pipelines:8080"
    route:
      group_by:
        - alertname
        - job
      group_interval: 5m
      group_wait: 30s
      receiver: "tekton-webhook-notifications-and-slack"
      repeat_interval: 24h
      routes:
        - matchers:
          - alertname=~"Watchdog"
          receiver: "null"
        - matchers:
          - alertname=~"FailBotsScraper"
          repeat_interval: 12h
          receiver: "tekton-fail-bots-webhook-notifications-and-slack"
        - matchers:
          - alertname=~"DomeMappingChanged"
          receiver: "slack-dome-mapping"
        - matchers:
          - alertname=~"BotsDomeHealthchekScraperRunRequests|BotsDomeHealthchekQueueReaderActiveWorkers"
          receiver: "slack-dome-bots"
        - matchers:
          - alertname=~"BotsMinionHealthchekScraperRunRequests|BotsMinionHealthchekQueueReaderActiveWorkers"
          receiver: "slack-minion-bots"
        - matchers:
          - alertname=~"PodPhaseFailed|KubePodNotReady"
        - matchers:
          - alertname=~"ETLJobsFailed"
          receiver: "tekton-failed-etl-jobs-webhook-notifications-and-slack"
        - matchers:
          - alertname=~"ETLLeftOvers"
          receiver: "tekton-etl-leftovers-webhook"
        - matchers:
          - alertname=~"TelegramRunPrepsServerTotal"
          receiver: "telegram-session-change-proxy-webhook"
        - matchers:
          - severity=~"etl"
          - cluster=~"production"
          receiver: "slack-etl"
        - matchers:
          - namespace=~"etl"
          - cluster=~"production"
          receiver: "slack-etl"
        - matchers:
          - severity=~"paste"
          - cluster=~"production"
          receiver: "slack-paste"
        - matchers:
          - severity=~"devs"
          receiver: "slack-devs"
        - matchers:
          - alertname=~".*"
          receiver: "tekton-webhook-notifications-and-slack"
          routes:
          - matchers:
            - not_resolve=~"yes"
            receiver: "tekton-and-slack-woresolve"
          - matchers:
            - severity=~"critical"
            - severity!~"etl"
            - severity!~"devs"
            - cluster=~"production"
            receiver: "slack-critical"
    templates:
      - /etc/alertmanager/config/*.tmpl
  templateFiles:
    slack-my.tmpl: |-
      {{ define "slack.custom.text"}}
      {{ with index .Alerts 0 -}}
          :chart_with_upwards_trend: *<{{ .GeneratorURL }}|Graph>*
          {{- if .Annotations.runbook }}   :notebook: *<{{ .Annotations.runbook }}|Runbook>*{{ end }}
      {{ end }}
      {{ range .Alerts }}
      *Alert:* {{ .Annotations.summary }}
      *Description:* {{ .Annotations.description }}
      {{ end }}
      {{ end }}

kubeControllerManager:
  enabled: false
coreDns:
  enabled: false
kubeDns:
  enabled: true

defaultRules:
  rules:
    kubeScheduler: false
    kubernetesResources: false
    kubeApiserver: false
    kubeProxy: false
  labels:
    ruler: thanos
  additionalRuleLabels:
    cluster: ${additional_rule_labels}

kubeScheduler:
  enabled: false
