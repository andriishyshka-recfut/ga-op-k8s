
subdomain: "${subdomain}"

vault:
    global:
      enabled: true

    server:
      image:
        repository: 'vault'
        tag: '${version}'

      extraEnvironmentVars:
        GOOGLE_REGION: global
        GOOGLE_PROJECT: ${project}
        GOOGLE_APPLICATION_CREDENTIALS: /vault/userconfig/kms-creds/credentials.json


      extraVolumes:
        - type: 'secret'
          name: 'kms-creds'

      ha:
        enabled: true
        replicas: 3

        config: |
          ui = true
          listener "tcp" {
            tls_disable = 1
            address = "[::]:8200"
            cluster_address = "[::]:8201"
          }
          seal "gcpckms" {
            project     = "${project}"
            region      = "global"
            key_ring    = "${key_ring}"
            crypto_key  = "${crypto_key}"
          }
          storage "gcs" {
            bucket = "${bucket}"
            ha_enabled    = "true"
          }
