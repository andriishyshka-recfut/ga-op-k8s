imageTag: ${imageTag}
elasticsearchHosts: "https://elasticsearch-coor.elastic.svc.cluster.local:9200"
protocol: http
elasticsearchCredentialSecret: kibana-${kibana_name}-es-credentials
elasticsearchCertificateSecret: elastic-https-certs
elasticsearchCertificateAuthoritiesFile: ca.crt
secretMounts: 
  - name: elastic-https-certs
    secretName: elastic-https-certs
    path: /usr/share/kibana/config/https-certs
    defaultMode: 0555
podAnnotations:
  sidecar.istio.io/inject: "true"
  co.elastic.logs/enabled: "true"
  co.elastic.logs/json.overwrite_keys: "true" 
  co.elastic.logs/json.add_error_key: "true" 
  co.elastic.logs/json.expand_keys: "true"
envFrom:
  - secretRef:
      name: kibana-${kibana_name}-credentials
extraEnvs:
  - name: "SERVER_NAME"
    valueFrom:
      fieldRef:
        fieldPath: metadata.name
replicas: ${settings.replicas}
fullnameOverride: kb-${kibana_name}
updateStrategy:
  type: RollingUpdate
kibanaConfig:
  kibana.yml: |
    elasticsearch:
      requestTimeout: 10h
      ssl:
        certificateAuthorities: /usr/share/kibana/config/https-certs/ca.crt
        verificationMode: certificate
      username: kibana_system
      password: '$${KIBANA_PASSWORD}'
    monitoring:
      kibana:
        collection:
          enabled: "false"
      ui:
        container:
          elasticsearch:
            enabled: "true"
    csp:
      strict: "true"
      script_src:
        - "'self'"
        - https://*.elastic.co
        - https://1rf.okta.com
      frame_src:
        - "'self'"
        - https://*.elastic.co
        - https://1rf.okta.com
      connect_src:
        - "'self'"
        - https://*.elastic.co
        - https://1rf.okta.com
    xpack:
      license_management:
        ui:
          enabled: false
      reporting:
        capture:
          browser:
            chromium:
              disableSandbox: "true"
        encryptionKey: ${kibana_xpack_secrets.reportingEncryptionKey}
        roles:
          enabled: false
      encryptedSavedObjects:
        encryptionKey: ${kibana_xpack_secrets.encryptedSavedObjectsEncryptionKey}
      security:
        encryptionKey: ${kibana_xpack_secrets.securityEncryptionKey}
        cookieName: sc-${kibana_name}
        sameSiteCookies: Lax
        session:
          idleTimeout: "1d"
          lifespan: "30d"
          cleanupInterval: "1d"
        audit:
          enabled: "true"
        authc:
          selector: 
            enabled: "true"
          providers:
%{ if lookup(settings, "basic_auth", false) ~}
            basic:
              basic1:
                order: 0
%{ endif ~}
%{ if length(settings.authorizations) > 0 ~}
%{ for auth_key, auth in settings.authorizations ~}
            %{ if auth.type == "okta" || auth.type == "oidc" ~}oidc%{ else ~}${auth.type}%{ endif ~}:
              ${auth_key}:
                order: ${index(keys(settings.authorizations), auth_key) + order_counter }
                realm: ${auth.realm}
                description: %{if lookup(auth, "description",false) != false} ${auth.description} %{else}Log in with ${auth.type}/${auth.realm} %{ endif }
%{ endfor ~}
%{ endif ~}
    server:
      host: "0.0.0.0"
      publicBaseUrl: ${settings.publicBaseUrl}
      ssl:
        supportedProtocols:
        - TLSv1.2
        - TLSv1.3
    savedObjects:
      maxImportExportSize: ${settings.maxImportExportSize}