apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: mon-elastic-creds
  namespace: monitoring
spec:
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        key: secret/data/mw/elastic/mon
        metadataPolicy: None
  refreshInterval: 1h
  secretStoreRef:
    kind: SecretStore
    name: vault-backend
  target:
    creationPolicy: Owner
    deletionPolicy: Retain
    name: mon-elastic-creds
    template:
      data:
        elastic: '{{ .password }}'
      engineVersion: v2
      mergePolicy: Replace
