curl -X PUT "https://elastic:$ES_PASSWORD@${settings.elastic_service}:9200/_security/role/metricbeat_role" -H 'Content-Type: application/json' -k -d '
{
  "cluster": ["monitor","manage_ilm"],
  "indices": [
    {
      "names": ["metricbeat-*"],
      "privileges": ["write","manage"]
    }
  ]
} ' &&\
curl -X PUT "https://elastic:$ES_PASSWORD@${settings.elastic_service}:9200/_security/user/${user}" -H 'Content-Type: application/json' -k -d '
{
    "roles" : ["kibana_admin","ingest_admin","remote_monitoring_agent","metricbeat_role","remote_monitoring_collector","monitoring_user"],
    "password": "${password}"
}'