imageTag: ${globalSettings.imageTag}
fullnameOverride: ${name}
extraEnvs:
  - name: METRICBEAT_PASSWORD
    valueFrom:
      secretKeyRef:
        name: ${name}-credentials
        key: password
secretMounts: 
  - name: elastic-https-certs
    secretName: ${name}-elastic-ca
    path: /usr/share/elasticsearch/config/https-certs
    defaultMode: 0755
daemonset:
  enabled: false
deployment:
  metricbeatConfig:
    metricbeat.yml: |
      metricbeat.autodiscover:
        providers:
          - type: kubernetes
            scope: cluster
            hints.enabled: false
            templates:
              - condition:
                  contains:
                    kubernetes.labels.chart: "elasticsearch"
                config:
%{ for logstash_name,logstash_value in logstash_pipelines_creds ~}
                  - module: logstash
                    metricsets: ["node", "node_stats"]
                    enabled: true
                    period: 10s
                    hosts: ["${logstash_name}.${logstash_value.namespace}.svc:9600"]
                    username: logstash
                    password: ${logstash_value.password}
                    xpack.enabled: true
%{ endfor ~}
                  - module: elasticsearch
                    period: 10s
                    metricsets:
                      - ccr
                      - cluster_stats
                      - enrich
                      - index
                      - index_recovery
                      - index_summary
                      - ml_job
                      - node_stats
                      - shard
                    hosts: 
%{ for nodepool,nodepooldata in nodePools ~}
%{ for counter in range(nodepooldata.replicas) ~}
                      - https://${globalSettings.clusterName}-${nodepool}-${counter}.${globalSettings.clusterName}-${nodepool}-headless.${globalSettings.namespace}.svc.cluster.local:9200
%{ endfor ~}
%{ endfor ~}
                    username: metricbeat_user
                    password: $${METRICBEAT_PASSWORD}
                    # WARNING: disables TLS as the default certificate is not valid for the pod FQDN
                    # TODO: switch this to "certificate" when available: https://github.com/elastic/beats/issues/8164
                    ssl.certificate_authorities: [ "/usr/share/elasticsearch/config/https-certs/ca.crt" ]
                    #protocol: https
                    ssl.verification_mode: "full"
                    scope: node
                    xpack.enabled: true
              - condition:
                  contains:
%{ for key, value in settings.kibana_labels ~}
                    kubernetes.labels.${key}: "${value}"
%{ endfor ~}
                config:
                  - module: kibana
                    metricsets:
                      - stats
                    period: 10s
                    hosts: "${kibana}:5601"                    
                    username: ${name}-user
                    password: $${METRICBEAT_PASSWORD}
                    # WARNING: disables TLS as the default certificate is not valid for the pod FQDN
                    # TODO: switch this to "certificate" when available: https://github.com/elastic/beats/issues/8164
                    ssl.verification_mode: "none"
                    xpack.enabled: true
      output.elasticsearch:
        hosts: "${settings.elastic_service}"
        username: metricbeat_user
        password: $${METRICBEAT_PASSWORD}
        protocol: https
        ssl:
          certificate_authorities: [ "/usr/share/elasticsearch/config/https-certs/ca.crt" ]
      setup:
        kibana.host: "${settings.kibana_service}"
        dashboards.enabled: true
      logging:
        json: true