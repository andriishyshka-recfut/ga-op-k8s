imageTag: ${imageTag}
fullnameOverride: ${name}
extraEnvs:
  - name: AUDITBEAT_PASSWORD
    valueFrom:
      secretKeyRef:
        name: ${name}-credentials
        key: password
secretMounts:
  - name: elastic-https-certs
    secretName: ${name}-elastic-ca
    path: /usr/share/elasticsearch/config/https-certs
    defaultMode: 0755
auditbeatConfig:
  auditbeat.yml: |-
    auditbeat.config.modules:
      # Mounted `auditbeat-daemonset-modules` configmap:
      path: $${path.config}/modules.d/*.yml
      # Reload module configs as they change:
      reload.enabled: false

    logging.level: debug

    processors:
      - add_cloud_metadata:
      - add_process_metadata:
          match_pids: ['process.pid']
          include_fields: ['container.id']
      - add_kubernetes_metadata:
          host: $${NODE_NAME}
          default_indexers.enabled: true
          default_matchers.enabled: true
          indexers:
            - container:
          matchers:
            - fields.lookup_fields: ['container.id']

    output.elasticsearch:
      #ssl.verification_mode: "none"
      ssl:
        certificate_authorities: /usr/share/elasticsearch/config/https-certs/ca.crt
      hosts: "${settings.elastic_service}"
      protocol: https
      username: ${name}-user
      password: $${AUDITBEAT_PASSWORD}

    setup.kibana:
      host: "${settings.kibana_service}"
    setup.dashboards.enabled: true
    #setup.ilm.enabled: true

daemonset:
  tolerations:
    - key: workloadsType
      operator: Exists
      effect: NoSchedule
  auditbeatConfig:
    system.yml: |
      - module: file_integrity
        paths:
        - /hostfs/bin
        - /hostfs/usr/bin
        - /hostfs/sbin
        - /hostfs/usr/sbin
        - /hostfs/etc
        exclude_files:
        - '(?i)\.sw[nop]$'
        - '~$'
        - '/\.git($|/)'
        scan_at_start: true
        scan_rate_per_sec: 50 MiB
        max_file_size: 100 MiB
        hash_types: [sha1]
        recursive: true
      - module: auditd
        audit_rules: |
          # Executions
          -a always,exit -F arch=b64 -S execve,execveat -k exec
          # Unauthorized access attempts
          -a always,exit -F arch=b64 -S open,creat,truncate,ftruncate,openat,open_by_handle_at -F exit=-EACCES -k access
          -a always,exit -F arch=b64 -S open,creat,truncate,ftruncate,openat,open_by_handle_at -F exit=-EPERM -k access