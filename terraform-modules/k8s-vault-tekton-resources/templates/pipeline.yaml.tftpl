apiVersion: tekton.dev/v1beta1
kind: Pipeline
metadata:
  name: 01-core-components
  namespace: tekton-tasks
spec:
  workspaces:
    - name: ws
  tasks:
    - name: namespaces
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-namespaces"
        - name: branch
          value: "\\${branch}"

    - name: tekton-resources
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      runAfter:
        - namespaces
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-tekton-resources"
        - name: branch
          value: "\\${branch}"

    - name: minio
      taskRef:
        name: tg-run
      runAfter:
        - namespaces
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-minio"
        - name: branch
          value: "\\${branch}"

    - name: redis
      taskRef:
        name: tg-run
      runAfter:
        - namespaces
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-redis"
        - name: branch
          value: "\\${branch}"

    - name: external-secrets
      taskRef:
        name: tg-run
      runAfter:
        - namespaces
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-external-secrets"
        - name: branch
          value: "\\${branch}"

    - name: internal-ingress-services
      taskRef:
        name: tg-run
      runAfter:
        - namespaces
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-internal-services"
        - name: branch
          value: "\\${branch}"

    - name: monitoring-elastic
      taskRef:
        name: tg-run
      runAfter:
        - namespaces
        - internal-ingress-services
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-monitoring-elastic"
        - name: branch
          value: "\\${branch}"

    - name: stakater-reloader
      taskRef:
        name: tg-run
      runAfter:
        - monitoring-elastic
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-stakater"
        - name: branch
          value: "\\${branch}"

    - name: fluxcd
      taskRef:
        name: tg-run
      runAfter:
        - namespaces
        - external-secrets
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-fluxcd"
        - name: branch
          value: "\\${branch}"

    - name: fluxcd-resources
      taskRef:
        name: tg-run
      runAfter:
        - fluxcd
        - monitoring
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-fluxcd-resources"
        - name: branch
          value: "\\${branch}"

    - name: monitoring
      taskRef:
        name: tg-run
      runAfter:
        - namespaces
        - fluxcd
        - minio
        - internal-ingress-services
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-monitoring"
        - name: branch
          value: "\\${branch}"

    - name: kyverno
      taskRef:
        name: tg-run
      runAfter:
        - namespaces
        - fluxcd
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-kyverno"
        - name: branch
          value: "\\${branch}"

    - name: kubescape
      taskRef:
        name: tg-run
      runAfter:
        - monitoring
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-1/01-kubescape"
        - name: branch
          value: "\\${branch}"

---
apiVersion: tekton.dev/v1beta1
kind: Pipeline
metadata:
  name: 02-stop-workloads
  namespace: tekton-tasks
spec:
  workspaces:
    - name: ws
  tasks:
    - name: stop-apps
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-2/02-stop-apps"
        - name: branch
          value: "\\${branch}"

---
apiVersion: tekton.dev/v1beta1
kind: Pipeline
metadata:
  name: 02-kafka-collect-stats
  namespace: tekton-tasks
spec:
  workspaces:
    - name: ws
  tasks:
    - name: collect-stats
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-2/02-kafka-collect-stats"
        - name: branch
          value: "master"

---
apiVersion: tekton.dev/v1beta1
kind: Pipeline
metadata:
  name: 03-stop-data-services
  namespace: tekton-tasks
spec:
  workspaces:
    - name: ws
  tasks:
    - name: stop-data-services
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-3/03-stop-data-services"
        - name: branch
          value: "\\${branch}"

---
apiVersion: tekton.dev/v1beta1
kind: Pipeline
metadata:
  name: 04-disk-snapshots
  namespace: tekton-tasks
spec:
  workspaces:
    - name: ws
  tasks:
    - name: disk-snapshots
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-4/04-disk-snapshots"
        - name: branch
          value: "\\${branch}"

---
apiVersion: tekton.dev/v1beta1
kind: Pipeline
metadata:
  name: 05-deploy-data-services
  namespace: tekton-tasks
spec:
  workspaces:
    - name: ws
  tasks:
    - name: clickhouse
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-5/05-clickhouse"
        - name: branch
          value: "\\${branch}"

    - name: mongo
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-5/05-mongo"
        - name: branch
          value: "\\${branch}"

    - name: kafka-topics
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-5/05-clone-kafka-topics"
        - name: branch
          value: "\\${branch}"

    - name: kafka
      taskRef:
        name: tg-run
      runAfter:
        - kafka-topics
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-5/05-kafka"
        - name: branch
          value: "\\${branch}"

    - name: minio-helm
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-5/05-minio-helm"
        - name: branch
          value: "\\${branch}"

---
apiVersion: tekton.dev/v1beta1
kind: Pipeline
metadata:
  name: 05-kafka-check-data
  namespace: tekton-tasks
spec:
  workspaces:
    - name: ws
  tasks:
    - name: check-stats
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-5/05-kafka-check-data"
        - name: branch
          value: "\\${branch}"

---
apiVersion: tekton.dev/v1beta1
kind: Pipeline
metadata:
  name: 06-post-switching
  namespace: tekton-tasks
spec:
  workspaces:
    - name: ws
  tasks:

    - name: monitoring-post
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-monitoring-post"
        - name: branch
          value: "\\${branch}"

    - name: istio
      taskRef:
        name: tg-run
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-istio"
        - name: branch
          value: "\\${branch}"

    - name: tls-proxy
      taskRef:
        name: tg-run
      runAfter:
        - istio
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-tls-proxy"
        - name: branch
          value: "\\${branch}"

    - name: telepresence
      taskRef:
        name: tg-run
      runAfter:
        - ingress
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-telepresence"
        - name: branch
          value: "\\${branch}"

    - name: static-certs
      taskRef:
        name: tg-run
      runAfter:
        - istio
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-static-certs"
        - name: branch
          value: "\\${branch}"

    - name: ingress
      taskRef:
        name: tg-run
      runAfter:
        - istio
        - static-certs
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-ingress"
        - name: branch
          value: "\\${branch}"

    - name: internal-ingress
      taskRef:
        name: tg-run
      runAfter:
        - istio
        - static-certs
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-internal-ingress"
        - name: branch
          value: "\\${branch}"

    - name: post-postgres
      taskRef:
        name: tg-run
      runAfter:
        - ingress
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-postgres"
        - name: branch
          value: "\\${branch}"

    - name: nfs
      taskRef:
        name: tg-run
      runAfter:
        - ingress
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-nfs"
        - name: branch
          value: "\\${branch}"

    - name: tor-controller
      taskRef:
        name: tg-run
      runAfter:
        - ingress
        - tls-proxy
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-tor-controller"
        - name: branch
          value: "\\${branch}"

    - name: fluxcd
      taskRef:
        name: tg-run
      runAfter:
        - tor-controller
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-fluxcd-resources"
        - name: branch
          value: "\\${branch}"

    - name: kiali
      taskRef:
        name: tg-run
      runAfter:
        - fluxcd
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-kiali"
        - name: branch
          value: "\\${branch}"

    - name: etl-operator
      taskRef:
        name: tg-run
      runAfter:
        - fluxcd
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-etl-operator"
        - name: branch
          value: "\\${branch}"

    - name: cvat
      taskRef:
        name: tg-run
      runAfter:
        - fluxcd
        - nfs
      workspaces:
        - name: ws
          workspace: ws
      params:
        - name: path
          value: "k8s/tekton/stage-6/06-cvat"
        - name: branch
          value: "\\${branch}"
