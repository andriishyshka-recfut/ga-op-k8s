apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: vault-issuer
  namespace: default
spec:
  vault:
    path: pki/sign/cert-manager-${cluster}-${color}
    server: ${vault_addr}
    auth:
      kubernetes:
        role: cert-manager-${cluster}-${color}
        mountPath: /v1/auth/default-issuer-${cluster}-${color}
        secretRef:
          name: ${default_secret_name}
          key: token
