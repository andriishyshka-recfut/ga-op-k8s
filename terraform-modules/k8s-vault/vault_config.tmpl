
ui = true
log_format = "json"
listener "tcp" {
  tls_disable = 1
  address = "[::]:8200"
  cluster_address = "[::]:8201"
}
seal "gcpckms" {
  project     = "${project}"
  region      = "global"
  key_ring    = "${key_ring}"
  crypto_key  = "${crypto_key}"
}
storage "gcs" {
  bucket = "${bucket}"
  ha_enabled    = "true"
}
service_registration "kubernetes" {}
