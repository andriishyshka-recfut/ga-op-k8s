fullnameOverride: "${cluster_name}"

global:
  postgresql:
    username: "${root_username}"
    database: "${database}"
    repmgrUsername: "repmgr"
    repmgrDatabase: "repmgr"
    existingSecret: "${auth_secret_name}"
  pgpool:
    adminUsername: "admin"
    existingSecret: "${auth_secret_name}"
    srCheckUsername: "repmgr"

postgresql:
  replicaCount: ${postgres_replicas}
%{ if postgresql_image_repository != "" || postgresql_image_tag != "" }
  image:
%{ if postgresql_image_registry != "" }
    registry: "${postgresql_image_registry}"
%{ endif }
%{ if postgresql_image_repository != "" }
    repository: "${postgresql_image_repository}"
%{ endif }
%{ if postgresql_image_tag != "" }
    tag: "${postgresql_image_tag}"
%{ endif }
%{ endif }
  persistence:
    storageClass: ""
    selector:
      matchLabels:
        target: "${pv_selector_label}"
    size: "${storage_size}"
%{ if postgresql_resources != null }
  resources:
    ${replace(yamlencode(postgresql_resources), "\n", "\n    ")}
%{ endif }
%{ if postgresql_liveness_probe != null }
  livenessProbe:
    ${replace(yamlencode(postgresql_liveness_probe), "\n", "\n    ")}
%{ endif }
%{ if postgresql_readiness_probe != null }
  readinessProbe:
    ${replace(yamlencode(postgresql_readiness_probe), "\n", "\n    ")}
%{ endif }
%{ if postgresql_startup_probe != null }
  startupProbe:
    ${replace(yamlencode(postgresql_startup_probe), "\n", "\n    ")}
%{ endif }
%{ if postgresql_custom_liveness_probe != null }
  customLivenessProbe:
    ${replace(yamlencode(postgresql_custom_liveness_probe), "\n", "\n    ")}
%{ endif }
%{ if postgresql_custom_readiness_probe != null }
  customReadinessProbe:
    ${replace(yamlencode(postgresql_custom_readiness_probe), "\n", "\n    ")}
%{ endif }
%{ if postgresql_custom_startup_probe != null }
  customStartupProbe:
    ${replace(yamlencode(postgresql_custom_startup_probe), "\n", "\n    ")}
%{ endif }
  podAntiAffinityPreset: "${postgresql_pod_anti_affinity_preset}"
  # Keep this block as a fallback when preset-based anti-affinity is too simple
  # and we need custom topology keys or label selectors for postgres pods.
  # Example fallback:
  # affinity:
  #   podAntiAffinity:
  #     requiredDuringSchedulingIgnoredDuringExecution: []
  pdb:
    create: ${postgresql_pdb_create}
    minAvailable: ${postgresql_pdb_min_available}

pgpool:
  replicaCount: ${pgpool_replicas}
  srCheckUsername: "repmgr"
%{ if pgpool_passthrough }
  # Custom pool_hba.conf with a mixed frontend auth model (first match wins):
  #  - System users pgpool knows via pgpool_passwd (postgres, repmgr/sr_check) keep
  #    scram-sha-256, so their credentials are authenticated locally by pgpool via
  #    challenge-response and never transit the network in clear text.
  #  - Everyone else -- application users, both static <db>-rw|ro AND any dynamic
  #    role -- falls through to the clear-text `password` method (pass-through):
  #    pgpool relays the client password to the backend instead of storing it in
  #    pgpool_passwd, so Vault can rotate app passwords with no pgpool re-sync.
  # The per-user scram lines MUST precede the catch-all password lines. scram only
  # works for users present in pgpool_passwd (the system users) -- app users are
  # deliberately NOT loaded there, which is why they must use password, not scram.
  # enable_pool_hba stays on and PGPOOL_AUTHENTICATION_METHOD stays scram-sha-256
  # (Bitnami only allows md5/scram there); this hba overrides the frontend method
  # per user. NOTE: no TLS -> app passwords transit the pod network in clear text
  # (system users do not -- they use scram).
  poolHbaConfiguration: |-
    local   all   all                        trust
    host    all   repmgr      all            scram-sha-256
    host    all   postgres    all            scram-sha-256
    host    all   all         0.0.0.0/0      password
    host    all   all         ::/0           password
%{ endif }
%{ if pgpool_image_repository != "" || pgpool_image_tag != "" }
  image:
%{ if pgpool_image_registry != "" }
    registry: "${pgpool_image_registry}"
%{ endif }
%{ if pgpool_image_repository != "" }
    repository: "${pgpool_image_repository}"
%{ endif }
%{ if pgpool_image_tag != "" }
    tag: "${pgpool_image_tag}"
%{ endif }
%{ endif }
%{ if pgpool_resources != null }
  resources:
    ${replace(yamlencode(pgpool_resources), "\n", "\n    ")}
%{ endif }
%{ if pgpool_liveness_probe != null }
  livenessProbe:
    ${replace(yamlencode(pgpool_liveness_probe), "\n", "\n    ")}
%{ endif }
%{ if pgpool_readiness_probe != null }
  readinessProbe:
    ${replace(yamlencode(pgpool_readiness_probe), "\n", "\n    ")}
%{ endif }
%{ if pgpool_startup_probe != null }
  startupProbe:
    ${replace(yamlencode(pgpool_startup_probe), "\n", "\n    ")}
%{ endif }
%{ if pgpool_custom_liveness_probe != null }
  customLivenessProbe:
    ${replace(yamlencode(pgpool_custom_liveness_probe), "\n", "\n    ")}
%{ endif }
%{ if pgpool_custom_readiness_probe != null }
  customReadinessProbe:
    ${replace(yamlencode(pgpool_custom_readiness_probe), "\n", "\n    ")}
%{ endif }
%{ if pgpool_custom_startup_probe != null }
  customStartupProbe:
    ${replace(yamlencode(pgpool_custom_startup_probe), "\n", "\n    ")}
%{ endif }
  podAntiAffinityPreset: "${pgpool_pod_anti_affinity_preset}"
  # Keep this block as a fallback when preset-based anti-affinity is too simple
  # and we need custom topology keys or label selectors for pgpool pods.
  # Example fallback:
  # affinity:
  #   podAntiAffinity:
  #     requiredDuringSchedulingIgnoredDuringExecution: []
  pdb:
    create: ${pgpool_pdb_create}
    minAvailable: ${pgpool_pdb_min_available}

service:
  type: ClusterIP

metrics:
  enabled: ${metrics_enabled}
%{ if metrics_image_repository != "" || metrics_image_tag != "" }
  image:
%{ if metrics_image_registry != "" }
    registry: "${metrics_image_registry}"
%{ endif }
%{ if metrics_image_repository != "" }
    repository: "${metrics_image_repository}"
%{ endif }
%{ if metrics_image_tag != "" }
    tag: "${metrics_image_tag}"
%{ endif }
%{ endif }
  service:
    enabled: ${metrics_service_enabled}
  serviceMonitor:
    enabled: ${metrics_service_monitor_enabled}
    namespace: "${metrics_service_monitor_namespace}"
%{ if metrics_service_monitor_interval != "" }
    interval: "${metrics_service_monitor_interval}"
%{ endif }
%{ if metrics_service_monitor_labels != null }
    labels:
      ${replace(yamlencode(metrics_service_monitor_labels), "\n", "\n      ")}
%{ endif }
