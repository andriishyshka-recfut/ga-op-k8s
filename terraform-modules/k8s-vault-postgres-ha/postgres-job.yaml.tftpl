apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: ${namespace}
spec:
  template:
    spec:
      volumes:
        - name: secret-postgres
          secret:
            secretName: ${secret_name}
      containers:
        - name: post
          image: ${image}:${tag}
          imagePullPolicy: Always
          env:
            - name: DEBUG
              value: "False"
            - name: VAULT_ROLE_NAME
              value: ${vault_role_name}
            - name: VAULT_ROLE_PATH
              value: ${vault_role_path}
            - name: VAULT_ADDR
              value: "${vault_addr}"
          volumeMounts:
            - name: secret-postgres
              readOnly: true
              mountPath: "/etc/postgres/secret"
      restartPolicy: Never
      imagePullSecrets:
        - name: harbor
  backoffLimit: 0
