apiVersion: "cert-manager.io/v1"
kind: ClusterIssuer
metadata:
  name: "vault-${name}-issuer"
spec:
  vault:
    auth:
      kubernetes:
        mountPath: "/v1/auth/k8s-${Cluster}-${Color}"
        role: cert-manager
        secretRef:
          key: token
          name: "sa-${Cluster}-cert-manager"
    path: "pki-${name}/sign/${name}"
    server: ${VaultAddress}
