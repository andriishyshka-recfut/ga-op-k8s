apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: ${ name }
  namespace: ${ lookup(values ,"namespace", globals.namespace) }
spec:
  interval: 30s
  type: ${ values.type}
  url: ${ values.url}
%{ if lookup(values, "secret_ref", false) != false ~}
  secretRef:
    name: ${values.secret_ref}
%{ endif ~}
%{ if lookup(values, "cert_secret_ref", false) != false ~}
  certSecretRef:
    name: ${values.cert_secret_ref}
%{ endif ~}

