apiVersion: kustomize.toolkit.fluxcd.io/v1beta2
kind: Kustomization
metadata:
  name: ${ name }
  namespace: ${ lookup(values ,"namespace", globals.namespace) }
spec:
  interval: 5m
  path: "${ values.kustomization_path }"
  prune: true
  sourceRef:
    kind: GitRepository
    name: ${ values.git_repository }
  timeout: 2m
