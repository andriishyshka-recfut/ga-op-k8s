apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: ${ name }
  namespace: ${ lookup(values ,"namespace", globals.namespace) }
spec:
  interval: 30s
  url: ${ values.url }
  provider: ${lookup (values, "provider", globals.provider )}
  ref:
    branch: ${ values.git_branch }
  secretRef:
    name: ${ lookup(values, "provider", globals.provider ) == "github" ? globals.github_token : globals.gitlab_token }
