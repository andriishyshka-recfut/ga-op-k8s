apiVersion: source.toolkit.fluxcd.io/v1beta2
kind: GitRepository
metadata:
  name: ${ name }
  namespace: ${ lookup(values ,"namespace", globals.namespace) }
spec:
  interval: 30s
  url: ${ values.url }
  ref:
    branch: ${ values.git_branch }
  secretRef:
    name: ${ lookup(values ,"gitlab_token", globals.gitlab_token) }
