# https://toolkit.fluxcd.io/components/notification/provider/#example
apiVersion: notification.toolkit.fluxcd.io/v1beta3
kind: Provider
metadata:
  name: ${ name }
  namespace: ${ lookup(values ,"namespace", globals.namespace) }
spec:
  type: ${ values.type }
  channel: ${ values.slack_chanel }
  secretRef:
    name: ${ values.webhook_url }
