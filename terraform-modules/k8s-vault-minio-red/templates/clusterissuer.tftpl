apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: vault-minio
spec:
  vault:
    auth:
      kubernetes:
        mountPath: /v1/auth/k8s-${cluster}-${color}
        role: cert-manager
        secretRef:
          key: token
          name: sa-${cluster}-cert-manager
    path: pki-minio/sign/minio
    server: ${vault_addr}