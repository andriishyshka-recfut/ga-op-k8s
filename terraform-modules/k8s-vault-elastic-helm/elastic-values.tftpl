replicas: ${replicas}
minimumMasterNodes: 1
clusterName: ${globalSettings.clusterName}
clusterHealthCheckParams: ${globalSettings.clusterHealthCheckParams}
nodeGroup: ${nodePool}
labels:
  metricbeat: true
podAnnotations: %{ if length(globalSettings.podAnnotations) == 0 ~} {} %{ else }
%{ for annotation,annotationValue in globalSettings.podAnnotations ~}
  ${annotation}: ${annotationValue}
%{ endfor ~}
%{ endif ~}
resources:
  requests:
    cpu: ${ resources.cpuReq }
    memory: ${ resources.memReq }
  limits:
%{ if lookup(resources,"cpuLimit", false) != false ~}
    cpu: ${ resources.cpuLimit }
%{ endif ~}
    memory: ${ resources.memLimit }
esJavaOpts: ${esJavaOpts}
roles:
%{ if lookup(roles, "master", "false") == "true" ~}
  - master
%{ endif ~}
%{ if lookup(roles, "ingest", "false") == "true" ~}
  - ingest
%{ endif ~}
%{ if lookup(roles, "data", "false") == "true" ~}
  - data
%{ endif ~}
%{ if lookup(roles, "remote_cluster_client", "false") == "true" ~}
  - remote_cluster_client
%{ endif ~}
%{ if lookup(globalSettings, "volumeExt", false) ~}
persistence:
  enabled: false
%{ else ~}
volumeClaimTemplate:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: ${storage}
%{ endif ~}
nodeSelector:
  workloadsType: "${workloadsType}"
tolerations:
  - key: workloadsType
    operator: Exists
    effect: NoSchedule
  - key: node.kubernetes.io/not-ready
    operator: Exists
    effect: NoExecute
  - key: node.kubernetes.io/unreachable
    operator: Exists
    effect: NoExecute
readinessProbe:
  failureThreshold: 3
  initialDelaySeconds: 200
  periodSeconds: 10
  successThreshold: 3
  timeoutSeconds: 5
extraVolumes:
  - name: elastic-plugins-local
    emptyDir: {}
  - name: elastic-transport-certificates
    emptyDir: {}
extraVolumeMounts:
  - name: elastic-plugins-local
    mountPath: /usr/share/elasticsearch/plugins
  - name: elastic-transport-certificates
    mountPath: /usr/share/elasticsearch/config/transport-certs
%{ if length(globalSettings.plugins) > 0 ~}
extraInitContainers:
  - name: fix-data-permissions
    image: docker.elastic.co/elasticsearch/elasticsearch:${globalSettings.imageTag}
    command:
      - sh
      - -c
      - chown -R 1000:1000 /usr/share/elasticsearch/data
    securityContext:
      runAsUser: 0
      runAsNonRoot: false
    volumeMounts:
      - name: ${globalSettings.clusterName}-${nodePool}
        mountPath: /usr/share/elasticsearch/data
  - name: install-plugins
    image: docker.elastic.co/elasticsearch/elasticsearch:${globalSettings.imageTag}
    command:
      - sh
      - '-c'
      - >
%{ for plugin in distinct(globalSettings.plugins) ~}
        bin/elasticsearch-plugin install --batch ${plugin} %{ if index(globalSettings.plugins, plugin) +1 < length(distinct(globalSettings.plugins))  } && %{ endif }
%{ endfor ~}
    volumeMounts:
      - name: elastic-plugins-local
        mountPath: /usr/share/elasticsearch/plugins
%{ endif ~}
extraEnvs:
  - name: ELASTIC_PASSWORD
    valueFrom:
      secretKeyRef:
        name: elastic-credentials
        key: elastic
secret:
  enabled: false
createCert: false
secretMounts:
%{ for cert in globalSettings.transport.certs ~}
%{ if cert == globalSettings.transport.active ~}
  - name: elastic-transport-ca
    secretName: elastic-transport-certs-${cert}
    path: /usr/share/elasticsearch/config/transport-certs/active
    defaultMode: 0755
%{ else ~}
  - name: elastic-transport-ca-${cert}
    secretName: elastic-transport-certs-${cert}
    path: /usr/share/elasticsearch/config/transport-certs/${cert}
    defaultMode: 0755
%{ endif ~}
%{ endfor ~}
  - name: elastic-https-certs
    secretName: elastic-https-certs
    path: /usr/share/elasticsearch/config/https-certs
    defaultMode: 0755
%{ if length(lookup(globalSettings, "remotecerts", [])) > 0 ~}
  - name: elastic-remote-certs
    secretName: elastic-remote-certs
    path: /usr/share/elasticsearch/config/transport-certs/remote
    defaultMode: 0755
%{ endif ~}
%{ if lookup(globalSettings.addons, "authorizations", 0) != 0 ~}
%{ for auth in globalSettings.addons.authorizations ~}
%{ if auth.type == "saml" ~}
  - name: elastic-${ auth.secret_name }
    secretName: ${ auth.secret_name }
    path: /usr/share/elasticsearch/config/saml/${ auth.secret_name }
    defaultMode: 0755
%{ endif ~}
%{ endfor ~}
%{ endif ~}
keystore: %{ if length(globalSettings.plugins) == 0 } [] %{ endif }
%{ if contains(globalSettings.plugins, "repository-s3") ~}
  - secretName: minio-credentials
%{ endif ~}
%{ if contains(globalSettings.plugins, "repository-gcs") ~}
  - secretName: gcs-credentials
%{ endif ~}
%{ if lookup(globalSettings.addons.notifications, "slack", 0) != 0 ~}
  - secretName: slack-notification
%{ endif ~}
%{ if lookup(globalSettings.addons.notifications, "email", 0) != 0 ~}
  - secretName: email-notification
%{ endif ~}
%{ if lookup(globalSettings.addons, "authorizations", 0) != 0 ~}
%{ for auth in globalSettings.addons.authorizations ~}
%{ if auth.type == "oidc" || auth.type == "okta"~}
  - secretName: ${ auth.secret_name }
%{ endif ~}
%{ endfor ~}
%{ endif ~}
%{ if lookup(globalSettings, "keystores", 0) != 0 ~}
%{ for keystore in globalSettings.keystores ~}
  - secretName: ${ keystore }-credentials
%{ endfor ~}
%{ endif ~}
protocol: https
esConfig:
  elasticsearch.yml: |
    xpack.security.enabled: true
    xpack.security.transport.ssl.enabled: true
    xpack.security.transport.ssl.verification_mode : ${ globalSettings.transport.verification_mode }
    xpack.security.transport.ssl.key: /usr/share/elasticsearch/config/transport-certs/active/tls.key
    xpack.security.transport.ssl.certificate: /usr/share/elasticsearch/config/transport-certs/active/tls.crt
    xpack.security.transport.ssl.certificate_authorities:
      - /usr/share/elasticsearch/config/transport-certs/active/ca.crt
%{ for cert in globalSettings.transport.certs ~}
%{ if cert != globalSettings.transport.active ~}
      - /usr/share/elasticsearch/config/transport-certs/${cert}/ca.crt
%{ endif ~}
%{ endfor ~}   
%{ if length(lookup(globalSettings, "remotecerts", [])) > 0 ~}
%{ for cert in globalSettings.remotecerts ~}
      - /usr/share/elasticsearch/config/transport-certs/remote/${cert}
%{ endfor ~}
%{ endif ~}
    xpack.security.http.ssl.enabled: true
    xpack.security.http.ssl.key: /usr/share/elasticsearch/config/https-certs/tls.key
    xpack.security.http.ssl.certificate: /usr/share/elasticsearch/config/https-certs/tls.crt
    xpack.security.http.ssl.certificate_authorities: /usr/share/elasticsearch/config/https-certs/ca.crt
%{ if lookup(globalSettings.addons.notifications, "slack", 0) != 0 ~}
${ slackNotification }
%{ endif ~}
%{ if lookup(globalSettings.addons.notifications, "email", 0) != 0 ~}
${ emailNotification }
%{ endif ~}
%{ if lookup(globalSettings.addons, "authorizations", 0) != 0 ~}
${ configAuth }
%{ endif ~}
%{ if lookup(globalSettings, "newCCR", false) ~}
    remote_cluster_server.enabled: true
    remote_cluster.host: 0.0.0.0
    remote_cluster.port: 9443
    xpack.security.remote_cluster_server.ssl.enabled: true
    xpack.security.remote_cluster_server.ssl.key: /usr/share/elasticsearch/config/transport-certs/active/tls.key
    xpack.security.remote_cluster_server.ssl.certificate: /usr/share/elasticsearch/config/transport-certs/active/tls.crt
    xpack.security.remote_cluster_server.ssl.certificate_authorities:
      - /usr/share/elasticsearch/config/transport-certs/active/ca.crt
%{ for cert in globalSettings.transport.certs ~}
%{ if cert != globalSettings.transport.active ~}
      - /usr/share/elasticsearch/config/transport-certs/${cert}/ca.crt
%{ endif ~}
%{ endfor ~}
%{ endif ~}
    xpack.security.audit.enabled: true
    xpack.security.audit.logfile.events.include: "access_denied, access_granted, anonymous_access_denied, authentication_success, authentication_failed"
