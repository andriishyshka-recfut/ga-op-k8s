variable "Settings" {}
variable "Cluster" {}
variable "Color" {}
variable "VaultAddress" {}
variable "RuntimeContext" {}


provider "vault" {
  address = var.VaultAddress
}

locals {

  activeCluster          = var.Color
  inactiveCluster        = local.activeCluster == "blue" ? "green" : "blue"
  activeClusterVaultPath = "secret/kubernetes-$${var.Cluster}-$${local.activeCluster}"
  inactiveClusterVaultPath = "secret/kubernetes-$${var.Cluster}-$${local.inactiveCluster}"
  gkeClusterConnectionSettings = {
    HOST                   = data.vault_generic_secret.k8s_auth.data.HOST
    API_KEY                = data.vault_generic_secret.k8s_auth.data.k8s_sa_token
    CLUSTER_CA_CERTIFICATE = data.vault_generic_secret.k8s_auth.data.CLUSTER_CA_CERTIFICATE
  }
  artifactoryRepoDomain = var.RuntimeContext == "tekton" ? "repo-external.recfut.com" : "repo.recfut.com"
}

data "vault_generic_secret" "k8s_auth" {
  path = local.activeClusterVaultPath
}

data "vault_generic_secret" "harbor_token" {
  path = "secret/goharbor/docker_login"
}

data "vault_kv_secret_v2" "artifactory_creds" {
  mount = "secret"
  name  = "misc/artifactory/creds"
}

provider "helm"  {
  kubernetes = {
    host                   = data.vault_generic_secret.k8s_auth.data.HOST
    cluster_ca_certificate = data.vault_generic_secret.k8s_auth.data.CLUSTER_CA_CERTIFICATE
    token                  = data.vault_generic_secret.k8s_auth.data.k8s_sa_token
  }
  registries = [
    {
      url      = "oci://harbor.regemini.io"
      username = data.vault_generic_secret.harbor_token.data.user
      password = data.vault_generic_secret.harbor_token.data.password
    }
  ]
}

provider "kubernetes" {
  host                   = data.vault_generic_secret.k8s_auth.data.HOST
  cluster_ca_certificate = data.vault_generic_secret.k8s_auth.data.CLUSTER_CA_CERTIFICATE
  token                  = data.vault_generic_secret.k8s_auth.data.k8s_sa_token

}

%{ if contains(additional_providers,"kubectl") ~}
provider "kubectl" {
  host                   = data.vault_generic_secret.k8s_auth.data.HOST
  cluster_ca_certificate = data.vault_generic_secret.k8s_auth.data.CLUSTER_CA_CERTIFICATE
  token                  = data.vault_generic_secret.k8s_auth.data.k8s_sa_token
  load_config_file       = false
 } 
%{ endif ~}

terraform {
  # The configuration for this backend will be filled in by Terragrunt
  backend "kubernetes" {
    secret_suffix    = "${dir}"
    namespace = "tekton-pipelines"
    config_path = "./kubeconfig" 
  }
  required_providers {
    helm = {
      source  = "hashicorp/helm"
      version = "= 3.3.0"
    }

%{ if contains(additional_providers, "kubectl") ~}
    kubectl = {
      source  = "gavinbunney/kubectl"
      version = ">= 1.7.0"
    }
%{ endif ~}
  }
}
provider "random" {}

