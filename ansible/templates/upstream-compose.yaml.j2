version: '3'
services:
  {{ subdomain }}_upstreamd:
    build:
      context: .
      dockerfile: upstream-Dockerfile
    container_name: {{ subdomain }}_upstreamd
    restart: unless-stopped
    volumes:
    - ./data/nginx:/nginx
    environment:
    - HOST={{ k8s_host_url }}
    - UPSTREAM_FILE=/nginx/{{ subdomain }}-stream.conf
    - SUBDOMAIN={{ subdomain }}
    - NODE_PORT={{ nodePort }}
